# Copy this file to ".env" and fill in your real values.
# ".env" is listed in .gitignore, so it will never be uploaded to GitHub.
# For scheduled runs, the same names go into GitHub Secrets (Phase 6).

# On your computer, use a separate test database so local runs never clash
# with the official one that GitHub Actions updates (data/monitor.db).
# Do NOT add this line to GitHub Secrets.
MONITOR_DB=data/local.db

# Telegram - token from @BotFather, then get the chat ID with:
#   python -m monitor.telegram --get-chat-id
# No quotes, no spaces around "=".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, for later - Claude (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional - ReliefWeb app name and ACLED credentials (Phase 5)
RELIEFWEB_APPNAME=
ACLED_EMAIL=
ACLED_KEY=
